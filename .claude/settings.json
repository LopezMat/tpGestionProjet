{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/tableau.py)",
      "Bash(python scripts/tableau.py *)",
      "Bash(python scripts/test_proteger_valide.py)",
      "Bash(python scripts/test_restreindre_bash.py)",
      "Bash(python scripts/test_verifier_prod.py)",
      "Bash(python .claude/skills/verifier-prod/verifier_prod.py *)",
      "Bash(python scripts/test_tableau.py)",
      "Bash(python scripts/sonde_sante.py *)",
      "Bash(python scripts/test_sonde_sante.py)",
      "Bash(python3 scripts/tableau.py)",
      "Bash(python3 scripts/tableau.py *)",
      "Bash(python3 scripts/test_proteger_valide.py)",
      "Bash(python3 scripts/test_restreindre_bash.py)",
      "Bash(python3 scripts/test_verifier_prod.py)",
      "Bash(python3 .claude/skills/verifier-prod/verifier_prod.py *)",
      "Bash(python3 scripts/test_tableau.py)",
      "Bash(python3 scripts/sonde_sante.py *)",
      "Bash(python3 scripts/test_sonde_sante.py)",
      "Bash(python scripts/test_prod_locale.py)",
      "Bash(python scripts/test_prod_locale.py *)",
      "Bash(python scripts/verifier_validations.py)",
      "Bash(python scripts/verifier_validations.py *)",
      "Bash(python scripts/test_verifier_validations.py)",
      "Bash(python3 scripts/test_prod_locale.py)",
      "Bash(python3 scripts/test_prod_locale.py *)",
      "Bash(python3 scripts/verifier_validations.py)",
      "Bash(python3 scripts/verifier_validations.py *)",
      "Bash(python3 scripts/test_verifier_validations.py)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh workflow run *)",
      "Bash(python scripts/deployer_local.py *)",
      "Bash(python3 scripts/deployer_local.py *)",
      "Bash(py scripts/deployer_local.py *)",
      "Bash(python scripts/rollback_local.py *)",
      "Bash(python3 scripts/rollback_local.py *)",
      "Bash(py scripts/rollback_local.py *)",
      "Edit(/templates/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Read(**/.env*)",
      "Edit(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python >/dev/null 2>&1 && P=python || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_valide.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python >/dev/null 2>&1 && P=python || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/restreindre_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
