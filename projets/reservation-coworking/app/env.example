# Variables d'environnement de l'application (DEC-002 : fichier sans point initial).
# Aucune valeur ici : ne jamais écrire de secret dans le dépôt.
# En production locale, PORT et DATABASE_URL sont fournis par deploiement/docker-compose.yml.

# Port d'écoute de l'app (8000 dans le conteneur).
PORT=

# Base PostgreSQL, au format postgresql://utilisateur:mot_de_passe@hote:5432/base
# (converti en interne pour le pilote psycopg 3).
DATABASE_URL=

# Compte accueil initial : lus uniquement par `python -m reservation.init_accueil`
# (architecture.md § 7), passés sans valeur par `docker exec -e NOM`.
ACCUEIL_EMAIL=
ACCUEIL_MOT_DE_PASSE_INITIAL=

# GIT_COMMIT n'est PAS une variable à renseigner ici : c'est un argument de build
# (`docker build --build-arg GIT_COMMIT=<sha>`), figé dans l'image par le Dockerfile
# et renvoyé par /health. Repli : RENDER_GIT_COMMIT, sinon "inconnu".
