  "openapi": "3.1.0",
  "paths": {
    "/api/disponibilites": {
      "get": {
        "description": "Créneaux libres ou occupés des 3 salles pour un jour, de J à J+14 (H-10).\n\nProvisoirement public (DEC-011, T-013, T-020). Un samedi ou un dimanche : chaque salle\nest renvoyée avec une liste de créneaux vide. Aucune donnée de membre.",
        "operationId": "lister_disponibilites_api_disponibilites_get",
        "parameters": [
          {
            "description": "AAAA-MM-JJ",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "description": "AAAA-MM-JJ",
              "maxLength": 10,
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Disponibilites"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Lister Disponibilites"
      }
    },
    "/api/salles": {
      "get": {
        "description": "Fiches des 3 salles (F-06). Provisoirement public (DEC-011, T-013, T-020).",
        "operationId": "lister_salles_api_salles_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Salle"
                  },
                  "title": "Response Lister Salles Api Salles Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Lister Salles"
      }
    },
    "/health": {
      "get": {
        "description": "Public, sans session : SHA déployé et état de la base, rien d'autre.\n\nRépond au plus tard après `bdd.DELAI_BASE_S` (1 s) quand la base se tait, sans\nbloquer la boucle d'événements.",
        "operationId": "sante_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SanteReponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SanteReponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Sante"
      }
    }
  }
