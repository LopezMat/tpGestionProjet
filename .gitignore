# Production locale (DEC-003) : sauvegardes, historique et mot de passe de la base.
# Des données et un secret local ne vont jamais dans le dépôt (S3-R8).
/deploiement/local/

# Console de consultation (DEC-012) : site généré par scripts/console.py, jamais versionné.
/console/

# Page « qui fait quoi » (DEC-014) : générée par scripts/qui_fait_quoi.py, jamais versionnée.
# Le modèle scripts/qui_fait_quoi_modele.html et l'instantané projets/<slug>/qui-fait-quoi.json le sont.
/qui-fait-quoi.html

# Mode Direct de « Le bureau » (DEC-018), optionnel et local à chaque poste : journal des événements
# (métadonnées, sel local) et déclaration personnelle du hook d'observation, avec ses sauvegardes.
/direct/
/.claude/settings.local.json
/.claude/settings.local.json.*

__pycache__/
*.pyc
